pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

#include cozy_field.lua
#include cozy_helpers.lua

function _init()
  field_size_x, field_size_y=10,6
  field=init_field(field_size_x, field_size_y)
end

function _update()
  default_wet_duration_s=3
end

function _draw()
  pad_x, pad_y=1,2
  cls()
  draw_field(pad_x, pad_y)
end

