pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

#include cozy_field.lua
#include cozy_helpers.lua
#include cozy_player.lua

start_x=64
start_y=64
field_size_x=10
field_size_y=6
wet_duration_s=3
pad_x=1 
pad_y=1


function _init()
  field=new_field(field_size_x, field_size_y)
  player=new_player(start_x, start_y)
end

function _update()
  update_field(wet_duration_s)
  move_player()
  water_squares()
  plant_square()
  -- grow_plant()
  -- harvest_plant()
end

function _draw()
  cls(3)
  draw_field(pad_x, pad_y)
  draw_player()
end

